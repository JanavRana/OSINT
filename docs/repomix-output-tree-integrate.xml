<file path="graph/docker-compose-additions.yml">
# Additions to the project's docker-compose.yml for the Neo4j graph
# query/visualization layer (Section 14.2 of MASTER_DESIGN.md).
#
# Merge the `neo4j` service below into the top-level `services:` block,
# add `neo4j_data` / `neo4j_logs` to the top-level `volumes:` block, and
# merge the environment variables into the existing `backend` service
# definition.

services:
  neo4j:
    image: neo4j:5-community
    container_name: osint-neo4j
    environment:
      # NEO4J_AUTH takes the form <user>/<password>. Keep the password
      # out of version control; supply it via a .env file or the shell
      # environment (NFR10 — no hard-coded secrets).
      NEO4J_AUTH: "${NEO4J_USER:-neo4j}/${NEO4J_PASSWORD:?NEO4J_PASSWORD must be set}"
    ports:
      - "7474:7474"   # Neo4j Browser (HTTP)
      - "7687:7687"   # Bolt protocol
    volumes:
      - neo4j_data:/data
      - neo4j_logs:/logs
    restart: unless-stopped

  backend:
    # Merge these into the existing backend service's `environment:` block.
    environment:
      NEO4J_URI: "bolt://neo4j:7687"
      NEO4J_USER: "${NEO4J_USER:-neo4j}"
      NEO4J_PASSWORD: "${NEO4J_PASSWORD:?NEO4J_PASSWORD must be set}"
      NEO4J_DATABASE: "${NEO4J_DATABASE:-neo4j}"
    depends_on:
      - neo4j
      # (also keep any existing depends_on entries, e.g. postgres)

volumes:
  neo4j_data:
  neo4j_logs:
</file>

